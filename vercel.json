{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "web/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/web/demo.html" },
    { "src": "/demo", "dest": "/web/demo.html" },
    { "src": "/demo.js", "dest": "/web/demo.js" },
    { "handle": "filesystem" }
  ]
}
